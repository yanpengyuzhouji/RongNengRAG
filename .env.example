# RAG 知识库 — 环境变量配置模板
# 复制为 .env 并填入实际值

# ===== LLM API Key (OpenAI 兼容服务) =====
# 本地 vLLM/Xinference 等通常不校验 key, 可留空
# 云服务 (OpenAI / 阿里云百炼 / DeepSeek 等) 填真实 key
LLM_API_KEY=

# 说明: config.yaml 中 llm.openai.api_key 是直接配置方式;
#        通过环境变量 LLM_API_KEY 配置则优先级更高

# ===== 魔搭 (ModelScope) API Key — embedding 向量化用 =====
# 在 modelscope.cn 登录后 → 头像 → API-KEY 获取
# config.yaml 的 embedding.openai.api_key_env 会读取此变量
MODELSCOPE_API_KEY=

# ===== Excel 工作簿微服务 (可选) =====
# /excel/* 路由反代到该地址 (默认 http://127.0.0.1:8090)
# EXCEL_SERVICE_BASE=http://127.0.0.1:8090

# Excel 专用 LLM 的 API Key (微服务 config.yaml excel.llm.api_key_env 读取)
# EXCEL_LLM_API_KEY=
# API 认证（至少 24 字符）。单用户可只配置 RONGNENG_API_KEY。
RONGNENG_API_KEY=replace-with-a-random-key-at-least-24-chars
RONGNENG_API_PRINCIPAL=default
# 多用户可改用 JSON：{"alice":"...long key...","bob":"...long key..."}
# RONGNENG_API_KEYS_JSON=
